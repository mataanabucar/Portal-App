# -----------------------------------------------------------------------------
# Local server
# -----------------------------------------------------------------------------
SERVER_HOST=127.0.0.1
PORT=3000
FRONTEND_PORT=3011
REQUEST_TIMEOUT_MS=20000

# -----------------------------------------------------------------------------
# Default routing
# -----------------------------------------------------------------------------
ASK_PROVIDER=orchestrator
ASSISTANT_MODEL_MODE=orchestrator
ASSISTANT_MAX_TOOL_ROUNDS=4
CLOUD_LLM_PROVIDER=openai
CLOUD_LLM_API_KEY=
CLOUD_LLM_MODEL=
SUMMARY_PROVIDER=teamgpt
PARSER_PROVIDER=teamgpt
BRIEFING_PROVIDER=teamgpt

# -----------------------------------------------------------------------------
# Portal data source
# mock | json | html | cookie-html | playwright-html
# -----------------------------------------------------------------------------
PORTAL_SOURCE_MODE=mock
PORTAL_TARGET_URL=
PORTAL_METHOD=GET
PORTAL_HEADERS_JSON={}
PORTAL_BODY_JSON={}
PORTAL_COOKIE=
PORTAL_DATA_PATH=
PORTAL_CONTENT_SELECTOR=body
PORTAL_ITEM_SELECTOR=
PORTAL_LINK_SELECTOR=
PORTAL_FOLLOW_DETAIL_LINKS=false
PORTAL_MAX_ITEMS=25

# Browser-backed portal and TeamGPT authentication
PLAYWRIGHT_CONNECT_TO_EXISTING=false
PLAYWRIGHT_CDP_ENDPOINT=
PLAYWRIGHT_EXECUTABLE_PATH=
PLAYWRIGHT_USER_DATA_DIR=.local-browser/portal-profile
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_NAVIGATION_TIMEOUT_MS=30000

# -----------------------------------------------------------------------------
# Microsoft Graph delegated authentication
# Never commit real tenant IDs, client IDs, secrets, or token caches.
# -----------------------------------------------------------------------------
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_REDIRECT_URI=http://localhost:3069/auth/redirect
GRAPH_SCOPES=openid profile email offline_access https://graph.microsoft.com/.default
GRAPH_MAIL_SEND_ENABLED=false
GRAPH_TOKEN_CACHE_FILE=.local-auth/graph-tester-token.json

GRAPH_TESTER_HOST=127.0.0.1
GRAPH_TESTER_PORT=3069
GRAPH_TESTER_REDIRECT_URI=http://localhost:3069/auth/redirect
GRAPH_TESTER_TOKEN_CACHE_FILE=.local-auth/graph-tester-token.json
GRAPH_TESTER_AUTO_LOGIN_ON_STARTUP=true

# -----------------------------------------------------------------------------
# TeamGPT / GennyStudio / Knowledge Base
# Leave endpoint overrides blank to use the application defaults.
# -----------------------------------------------------------------------------
TEAMGPT_PAGE_URL=
TEAMGPT_ENDPOINT_URL=
TEAMGPT_PARSER_ENDPOINT_URL=
TEAMGPT_SUMMARY_ENDPOINT_URL=
TEAMGPT_ACTION_ENDPOINT_URL=
TEAMGPT_APP_ID=
TEAMGPT_ENVIRONMENT=prod
TEAMGPT_MODEL=
TEAMGPT_PARSER_MODEL=
TEAMGPT_SUMMARY_MODEL=
TEAMGPT_ACTION_MODEL=
TEAMGPT_LARGE_CONTEXT_MODEL=on
TEAMGPT_EXTENDED_THINKING=on
TEAMGPT_TOKEN_CACHE_FILE=.local-auth/teamgpt-token.json

GENNYSTUDIO_BASE_URL=
GENNYSTUDIO_AGENT_REF=aris_search
GENNYSTUDIO_REQUEST_TIMEOUT_MS=20000

KB_ENDPOINT=
KB_AUTH_TOKEN=
KB_UPLOAD_MARKER=
KB_REQUEST_TIMEOUT_MS=20000

# -----------------------------------------------------------------------------
# Sourcebot
# -----------------------------------------------------------------------------
SOURCEBOT_HOST=
SOURCEBOT_API_KEY=

# -----------------------------------------------------------------------------
# OpenAI — optional text fallback and clarification
# -----------------------------------------------------------------------------
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_ALLOW_TESTCHAT=false
ORCHESTRATOR_OPENAI_CLARIFY_ENABLED=false
ORCHESTRATOR_OPENAI_FALLBACK_ENABLED=false

# -----------------------------------------------------------------------------
# Optional BambooHR image proxy integration
# -----------------------------------------------------------------------------
BAMBOO_IMAGE_COOKIE=
BAMBOO_IMAGE_REFERER=
BAMBOO_IMAGE_USER_AGENT=
BAMBOO_IMAGE_REQUEST_TIMEOUT_MS=20000
