PORT=3000
REQUEST_TIMEOUT_MS=20000

PORTAL_SOURCE_MODE=mock
PORTAL_TARGET_URL=
PORTAL_METHOD=GET
PORTAL_HEADERS_JSON={}
DASHBOARD_CACHE_FILE=.local-state/dashboard-cache.json
PORTAL_COOKIE=
PORTAL_COOKIE_CACHE_FILE=.local-auth/portal-cookie-cache.json
PORTAL_BODY_JSON=
PORTAL_DATA_PATH=
PORTAL_CONTENT_SELECTOR=body
PORTAL_FRAME_SELECTOR=
PORTAL_ITEM_SELECTOR=
PORTAL_LINK_SELECTOR=
PORTAL_TITLE_SELECTOR=
PORTAL_DETAIL_SELECTOR=
PORTAL_STATUS_SELECTOR=
PORTAL_OWNER_SELECTOR=
PORTAL_PRIORITY_SELECTOR=
PORTAL_DATE_SELECTOR=
PORTAL_MAX_ITEMS=25
PORTAL_FOLLOW_DETAIL_LINKS=false
PORTAL_MAX_DETAIL_PAGES=10
PORTAL_DETAIL_CONTENT_SELECTOR=body
PORTAL_DETAIL_TITLE_SELECTOR=
PORTAL_DETAIL_MAX_CHARS=4000
PLAYWRIGHT_EXECUTABLE_PATH=
PLAYWRIGHT_USER_DATA_DIR=.local-browser/portal-profile
PLAYWRIGHT_CONNECT_TO_EXISTING=false
PLAYWRIGHT_CDP_ENDPOINT=
PLAYWRIGHT_DEVTOOLS_ACTIVE_PORT_FILE=
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_NAVIGATION_TIMEOUT_MS=30000

OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=merlin
OPENAI_ALLOW_TESTCHAT=true
OPENAI_REALTIME_ENABLED=true
OPENAI_REALTIME_MODEL=
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_REASONING_EFFORT=low
OPENAI_REALTIME_MAX_OUTPUT_TOKENS=900
SUMMARY_PROVIDER=teamgpt
# openai | teamgpt | local. "local" uses LOCAL_LLM_* below and only affects /api/ask.
ASK_PROVIDER=teamgpt
PARSER_PROVIDER=teamgpt
TEAMGPT_PAGE_URL=https://tools.benchmarkdigital.com/gsportal/genai/index.cfm
TEAMGPT_ENDPOINT_URL=https://genai-proxy-na.benchmarkdigital.com/bedrock/converse/chat/teamgpt-ask-anything-bedrock?stream=true
TEAMGPT_PARSER_ENDPOINT_URL=https://genai-proxy-na.benchmarkdigital.com/bedrock/converse/chat/teamgpt-ask-anything-bedrock?stream=false
TEAMGPT_APP_ID=9225
TEAMGPT_ENVIRONMENT=prod
TEAMGPT_MODEL=anthropic.claude-sonnet-4-5-20250929-v1:0
TEAMGPT_LARGE_CONTEXT_MODEL=on
TEAMGPT_EXTENDED_THINKING=on
TEAMGPT_PARSER_MODEL=anthropic.claude-sonnet-4-5-20250929-v1:0
TEAMGPT_TOKEN_CACHE_FILE=.local-auth/teamgpt-token.json

ASSISTANT_MODEL_MODE=local
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.2:3b
LOCAL_LLM_API_KEY=ollama

# Embeddings are switched independently of chat mode above — any combination
# works (e.g. local chat + cloud embeddings). Powers docsKb/codeKb RAG search.
ASSISTANT_EMBEDDING_MODE=local
LOCAL_EMBEDDING_BASE_URL=http://localhost:11434/v1
LOCAL_EMBEDDING_MODEL=nomic-embed-text
LOCAL_EMBEDDING_API_KEY=ollama

# Optional: where docsKb reads project documents from. Empty = repo's docs/
# folder (default). Accepts an absolute path or one relative to the repo root.
DOCS_KB_PATH=

KB_ENDPOINT=https://tools.benchmarkdigital.com/kb/callKBX.cfm
KB_AUTH_TOKEN=
KB_REQUEST_TIMEOUT_MS=20000

# Genny Studio (gstudio agent invoke) — primary research source, replaces
# callKBX.cfm in the research pipeline when it returns a usable answer.
# Reuses the same JWT as KB_AUTH_TOKEN/TeamGPT (teamGptAuthService); falls
# back to KB_ENDPOINT above if this fails or is unreachable.
GENNYSTUDIO_BASE_URL=https://genai-proxy-na.benchmarkdigital.com
GENNYSTUDIO_AGENT_REF=aris_search
GENNYSTUDIO_REQUEST_TIMEOUT_MS=20000

# Microsoft Graph / Azure AD
# Never commit GRAPH_CLIENT_SECRET to git.
# Prefer storing GRAPH_CLIENT_SECRET once as a Windows user environment variable:
#   [Environment]::SetEnvironmentVariable("GRAPH_CLIENT_SECRET", "<secret>", "User")
# Leave GRAPH_CLIENT_SECRET blank in .env when using the global variable.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_REDIRECT_URI=http://localhost:3069/auth/redirect
GRAPH_TESTER_HOST=127.0.0.1
GRAPH_TESTER_PORT=3069
# Optional. When blank, the standalone tester uses
# http://localhost:3069/auth/redirect based on GRAPH_TESTER_PORT.
# Do not rely on GRAPH_REDIRECT_URI for the standalone tester.
GRAPH_TESTER_REDIRECT_URI=
GRAPH_TESTER_TOKEN_CACHE_FILE=.local-auth/graph-tester-token.json
GRAPH_TESTER_AUTO_LOGIN_ON_STARTUP=true
# Space-separated list of delegated scopes to request.
# Assistant capabilities and the scopes they need:
#   search_emails -> Mail.Read (already below)
#   search_chats  -> Chat.Read AND ChannelMessage.Read.All (ChannelMessage.Read.All needs ADMIN consent)
#   send_email    -> Mail.Send Mail.ReadWrite (Mail.Send is included below)
# IMPORTANT: after changing GRAPH_SCOPES (e.g. adding Mail.Send), delete
# .local-auth/graph-tester-token.json and log in again — the cached token keeps
# the old scopes until a fresh login.
# .default = every delegated Graph permission the tenant has approved for this
# app; new Azure approvals flow in automatically. Do NOT enumerate individual
# Graph scopes — requesting even one unapproved scope makes token refresh fail
# with AADSTS65001. Functions are gated by the token's actual scp claim.
GRAPH_SCOPES=openid profile email offline_access https://graph.microsoft.com/.default

# Outbound email via the assistant is OFF by default (outward-facing action).
# Set to true AND grant Mail.Send + Mail.ReadWrite above, then re-login via the
# graph-tester so the cached token carries the new scopes. Every send still
# requires explicit in-app confirmation.
GRAPH_MAIL_SEND_ENABLED=false
