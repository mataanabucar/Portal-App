GRAPH_AUTHS_PORT=3070
GRAPH_AUTHS_HOST=127.0.0.1
GRAPH_AUTHS_REDIRECT_URI=http://localhost:3070/auth/redirect
GRAPH_AUTHS_OUTPUT_FILE=../.local-auth/graph-tester-token.json
GRAPH_AUTHS_AUTO_OPEN_BROWSER=true
GRAPH_AUTHS_BROWSER_MODE=chrome-clean

# Graph app registration values. These can also fall back to the parent app's
# GRAPH_* values if you run this mini app inside the same repo.
GRAPH_AUTHS_TENANT_ID=
GRAPH_AUTHS_CLIENT_ID=
GRAPH_AUTHS_CLIENT_SECRET=
# GRAPH_AUTHS_SCOPES intentionally unset — inherits GRAPH_SCOPES from repo root .env

# Browser modes:
# chrome-persisted = regular Chrome with your normal signed-in profile
# chrome-clean = regular Chrome with this app's separate unsigned profile
# edge = Microsoft Edge with its normal profile
# GRAPH_AUTHS_CHROME_EXECUTABLE_PATH=
# GRAPH_AUTHS_EDGE_EXECUTABLE_PATH=
# GRAPH_AUTHS_CHROME_CLEAN_USER_DATA_DIR=.local-browser/chrome-clean
