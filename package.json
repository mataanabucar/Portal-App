{
  "name": "portal-visualizer-local",
  "version": "0.1.0",
  "description": "Local desktop shell and portal dashboard for Benchmark portal work queue review.",
  "author": "Benchmark Gensuite",
  "private": true,
  "type": "module",
  "main": "src/desktop/bootstrap.cjs",
  "scripts": {
    "dev": "node scripts/launch-browser-dev.js",
    "dev:desktop": "node scripts/launch-desktop-shell.js --rebuild",
    "start": "node scripts/launch-desktop-shell.js",
    "desktop": "node scripts/launch-desktop-shell.js",
    "server": "node src/server/index.js",
    "server:dev": "node --watch src/server/index.js",
    "graph-tester": "node scripts/launch-graph-tester.js",
    "graph-tester:dev": "node scripts/launch-graph-tester.js --watch",
    "graph-tester:client": "npm --prefix src/graph-tester/client run dev",
    "graph-tester:client:build": "npm --prefix src/graph-tester/client run build",
    "pack:win": "electron-builder --win dir",
    "dist:win": "electron-builder --win nsis portable",
    "bundle:share": "node scripts/build-shareable-bundle.js",
    "bundle:localhost": "node scripts/build-localhost-shareable-bundle.js",
    "open:portal-profile": "node scripts/open-portal-profile.js",
    "smoke": "node scripts/smoke-test.js"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lucide": "^1.17.0",
    "openai": "^6.39.0",
    "playwright-core": "^1.54.2"
  },
  "devDependencies": {
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.benchmarkdigital.portalvisualizer",
    "productName": "Portal Visualizer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "public/**/*",
      "src/**/*",
      "scripts/**/*",
      "package.json",
      ".env.example",
      "README.md",
      "!notes/**/*",
      "!.local-browser/**/*",
      "!src/graph-tester/client/node_modules/**/*",
      "!src/graph-tester/client/src/**/*",
      "!src/graph-tester/client/*.ts",
      "!src/graph-tester/client/*.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}
